# このファイルをコピーして secrets.yaml を作り、値を書き換える
# secrets.yaml は Git に上げない

# Home Assistant / ESPHome
api_encryption_key: "YOUR_ESPHOME_API_ENCRYPTION_KEY"
# ota_password: "YOUR_OTA_PASSWORD"

# Wi-Fi
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Wi-Fi に繋がらないときのフォールバックAP
wisun_hotspot_password: "YOUR_FALLBACK_AP_PASSWORD"

# 電力会社のBルート認証
# ID は32文字
rb_id: "YOUR_B_ROUTE_ID"
rb_password: "YOUR_B_ROUTE_PASSWORD"
